{
  "name": "dsh-quick-model-selector",
  "version": "1.0.0",
  "description": "模型再多也好找：输入几个字就能搜，收藏和最近使用置顶，服务商分组可折叠；方向键加 Enter 快速切换，推理强度单独调。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./dist/client.js",
    "./logic": "./src/logic.js",
    "./locale/*": "./locale/*",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.png",
    "README.en.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "install:dsh": "npm run build && node scripts/install-local.mjs",
    "remove:dsh": "node scripts/install-local.mjs --remove"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnailMann/dsh-quick-model-selector.git"
  },
  "homepage": "https://github.com/SnailMann/dsh-quick-model-selector#readme",
  "bugs": {
    "url": "https://github.com/SnailMann/dsh-quick-model-selector/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "model-selector",
    "reasoning-effort"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
